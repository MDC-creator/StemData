# Configuration of OUR app. Copy to .env (git-ignored). Values below point at the local dev stack;
# for production, replace hosts, accounts and passwords with the service accounts of the lab.
APP_DB_PASSWORD=change-me
PUBLIC_URL=http://localhost:8090

# login: the first admin is created on the first start (only when no user exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-10
COOKIE_SECURE=false
# LOCAL TESTING ONLY: true allows simple passwords like root / root. Never on a shared server.
ALLOW_SIMPLE_PASSWORDS=false
# secret for the Nextcloud webhook (/api/hooks/nextcloud?token=...); empty = webhook off
WEBHOOK_TOKEN=
# OMERO (dev stack: same password as OMERO_ROOT_PASSWORD in infra/dev-stack/.env)
OMERO_HOST=omero-server
OMERO_PORT=4064
OMERO_USER=root
OMERO_PASSWORD=change-me
OMERO_PROJECT=INDUZELL
OMERO_WEB_PUBLIC_URL=http://localhost:4080

# Nextcloud (use an app password for a real server)
NEXTCLOUD_URL=http://nextcloud
NEXTCLOUD_USER=admin
NEXTCLOUD_PASSWORD=change-me
NEXTCLOUD_ROOT=INDUZELL
NEXTCLOUD_POLL_SECONDS=60

# eLabFTW (dev stack: key from infra/dev-stack/elabftw-populate.yml; self-signed cert -> no TLS check locally)
ELAB_URL=https://elabftw:8080
ELAB_PUBLIC_URL=https://localhost:8443
ELAB_API_KEY=change-me
ELAB_VERIFY_TLS=false
ELAB_SYNC_SECONDS=120
ELAB_WRITEBACK=true

# analysis: cellpose (accurate, slower) or classic (fast, no model)
SEGMENTER=cellpose
NUCLEUS_DIAMETER_UM=10
# a nucleus is dead if its EthD signal is >= ETHD_MIN_Z robust SDs above background AND >= ETHD_MIN_RATIO x brighter
ETHD_MIN_Z=6
ETHD_MIN_RATIO=1.5
WRITE_ROIS=true
